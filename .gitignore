# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Build / test artifacts
dist/
coverage/
*.log

# --- Models (large — track separately or via git-lfs) -----------------------
# The neural model file is gitignored. Each developer's scripts/fetch-model.sh
# downloads it on demand.
extension/models/*.onnx
extension/models/*.ort
extension/models/*.bin
extension/models/*.pt
extension/models/*.pth
extension/models/*.safetensors

# --- Vendored onnxruntime-web -----------------------------------------------
# We commit ort.min.js (small, ~360KB) so a fresh clone can load the extension
# immediately. The WASM binaries (large, ~40MB total) are gitignored — CI / new
# developer fetches them via scripts/fetch-model.sh.
#
# If we ever want to keep the WASM binaries in tree, do it via git-lfs, not
# raw blobs. The .jsep.wasm alone is 27MB which would explode clone size.
extension/vendor/*.wasm
extension/vendor/*.mjs
!extension/vendor/.gitkeep

# --- Eval data (large public datasets — fetch on demand) ---------------------
eval/dataset/
eval-data/
eval/tmp/

# --- Test data privacy -------------------------------------------------------
# Never commit any image fed to the eval harness.
*.jpg
*.jpeg
*.png
*.webp
*.gif
*.avif
# Exception: the icon files live under extension/icons/ and ARE checked in.
!extension/icons/*.png
